{
    "name": "sitecrafting/groot",
    "description": "The official SiteCrafting WordPress starter theme",
    "version": "1.0.0",
    "minimum-stability": "dev",
    "license": "MIT",
    "authors": [
        {
            "name": "SiteCrafting, Inc.",
            "email": "hello@sitecrafting.com"
        }
    ],
    "repositories": {
        "repo.packagist.com/sitecrafting/": {
            "type": "composer",
            "url": "https://repo.packagist.com/sitecrafting/"
        },
        "0": {
            "type": "composer",
            "url": "https://wpackagist.org"
        },
        "1": {
            "type": "composer",
            "url": "https://repo.packagist.com/sitecrafting/"
        },
        "packagist.org": false
    },
    "require": {
        "php": ">=8.1",
        "timber/timber": "^2.2"
    },
    "require-dev": {
        "composer/installers": "^2.0",
        "johnpbloch/wordpress-core-installer": "^2.0",
        "johnpbloch/wordpress-core": "^7.0.1",
        "mnsami/composer-custom-directory-installer": "^2.0",
        "squizlabs/php_codesniffer": "3.*",
        "wp-coding-standards/wpcs": "^0.14",
        "sitecrafting/conifer": "^1.0",
        "sitecrafting/advanced-custom-fields-pro": "^6.8"
    },
    "extra": {
        "installer-paths":
        {
            "wp/wp-content/mu-plugins/{$name}":
            [
                "type:wordpress-muplugin"
            ],
            "wp/wp-content/plugins/{$name}":
            [
                "type:wordpress-plugin"
            ]
        },
        "wordpress-install-dir": {
            "johnpbloch/wordpress-core": "wp"
        }
    },
    "autoload": {
        "psr-4": {
            "Project\\": "lib/Project/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "johnpbloch/wordpress-core-installer": true,
            "mnsami/composer-custom-directory-installer": true
        }
    }
}
