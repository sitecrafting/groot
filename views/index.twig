{% extends 'layouts/main.twig' %}

{% block main_content %}

{% include 'partials/hero-interior.twig' with { 
    page_title : newsPage.title, 
    nav_category_filter: true
} %}

<section class="pattern sitka-search-content-container">
    <div class="container">

        <div class="grid-container">
            {% for post in posts %}
                {% include 'partials/cards/article-card.twig' %}
            {% endfor %}
        </div><!-- END .grid-container -->

        {% if posts.pagination.current < posts.pagination.total %}
            {% include 'partials/blocks/pagination-posts.twig' with {
                'previous_text': 'Previous Articles',
                'next_text': 'Next Articles'
            } %}
        {% endif %}


	</div><!-- //.container -->
</section>
{% endblock %}
