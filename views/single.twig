{% extends 'layouts/main.twig' %}


{% block main_content %}

<article class="sitka-search-content-container">

    {% include 'partials/hero-interior.twig' with { 
        container_modifier: 'container--md', 
        headline_label: post.date('F j, Y'),
        page_title : post.title
    } %}

    {% include 'partials/content-layouts/standard_content.twig' with {
        layout : {
            content: post.content
        }
    } %}

    <div class="pattern"><div class="container container--md">

            <div class="post-taxonomy-list">
                <strong>Categories:</strong>
                <div class="tax-list">
                {% for category in post.categories %}
                    <a href="{{ category.link }}">{{ category }}</a>
                {% endfor %}
                </div>
            </div>

            <div class="post-back text-center">
                <a href="{{ get_blog_url() }}" class="btn">Back to News</a>
            </div>

	</div></div>

	{% include 'partials/content-layouts/latest_news.twig' with {
        layout: {
            get_related: true,
            pattern_headline: 'Related Articles'
        }
    } %}

</article>


{% endblock %}
