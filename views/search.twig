{% extends 'layouts/main.twig' %}

{% block main_content %}

{% include 'partials/hero-interior.twig' with { page_title : 'Search' } %}

<section class="pattern pattern--search">
    <div class="container container--md">

            {% if search_query %}
                <h2 class="search-title">Search Results for: {{ search_query }}</h2>
            {% else %}
                <h2 class="search-title">Search</h2>
            {% endif %}
            <div class="search-title-count">{{ enumerate_page }}</div>

            <div class="search-results-list">
                {% for post in posts %}
                    <div class="search-card">
                        <h3 class="title"><a href="{{ post.link }}">{{ post.title }}</a></h3>
                        {% if post.meta('_yoast_wpseo_metadesc') %}<div class="snippet">{{ post.meta('_yoast_wpseo_metadesc') }}</div>{% endif %}
                    </div>
                {% else %}

                    <p>Sorry, we couldn't find anything about <strong>{{ search_query }}</strong>, please try again.</p>

                {% endfor %}
            </div>

            {# if there is more than 1 page show the navigation #}
            {% if posts.pagination.current < posts.pagination.total %}
                {% include 'partials/blocks/pagination-posts-numbers.twig' with {
                    'previous_text': source('img/arrows/streamline-chevron-left@20x20.svg') ~ " Previous Articles",
                    'next_text': "Next Articles " ~ source('img/arrows/streamline-chevron-right@20x20.svg')
                } %}
            {% endif %}

    </div>
</section>
{% endblock %}
