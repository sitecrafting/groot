{% extends 'layouts/main.twig' %}

{% block main_content %}

<div class="slideshow-home-hero swiper{{ post.meta('hero')|length > 1 ? ' js-home-slideshow' }}">
    <div class="swiper-wrapper">

        <!-- Slides -->
        {% for slide in post.meta('hero') %}
        <div class="swiper-slide">
            {% include 'partials/hero.twig' with { hero : slide } %}
        </div><!-- //.swiper-slide -->
        {% endfor %}

    </div>
    {% if post.meta('hero')|length > 1 %}
    <div class="swiper-pagination"></div>

    <div class="swiper-button-prev">{{ source('img/arrows/streamline-chevron-left@20x20.svg') }}</div>
    <div class="swiper-button-next">{{ source('img/arrows/streamline-chevron-right@20x20.svg') }}</div>
    {% endif %}
</div>

{# FLEXIBLE LAYOUTS 
    * Standard Content
    * Latest News
    * CTA
#}
{% include 'partials/content-layouts.twig' with { layouts: post.meta('homepage_content') } %}


{% endblock %}
