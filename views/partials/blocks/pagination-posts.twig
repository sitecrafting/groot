<nav aria-label="{{ pagination_nav_label|default('Pagination Navigation') }}" class="pagination post-button-pagination">
    <div class="sr-only">Page {{ posts.pagination.current }} of {{ posts.pagination.total }}</div>
    <div class="nav-previous">
        {% if posts.pagination.prev is empty %}
            <span role="button" disabled aria-disabled="true" class="btn btn--disabled">{{ previous_text }}</span>
        {% else %}
            <a class="btn" href="{{posts.pagination.prev.link}}">{{ previous_text }}</a>
        {% endif %}
    </div>
    <div class="nav-next">
        {% if posts.pagination.next is empty %}
            <span role="button" disabled aria-disabled="true" class="btn btn--disabled">{{ next_text }}</span>
        {% else %}
            <a class="btn" href="{{posts.pagination.next.link}}">{{ next_text }}</a>
        {% endif %}
    </div>
</nav><!-- post-navigation -->

