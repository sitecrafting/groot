<section id="cta_{{ parent_loop.index|default(0) }}" class="pattern pattern--pad pattern--cta">
    <div class="container container--sm">

        <h2 class="h1 title">{{ layout.headline }}</h2>
        {% if layout.subtext %}
            <div class="subtext">{{ layout.subtext }}</div>
        {% endif %}
        {% if layout.button.url %}
            <a class="btn" href="{{ layout.button.url }}"{{ layout.button.target ? ' target="_blank" rel="noopener noreferrer"' }}>{{ layout.button.title|default('Learn More') }}{{ layout.button.target ? '<span class="sr-only">(opens in new tab)</span>' }}</a>
        {% endif %}

    </div>
</section>
