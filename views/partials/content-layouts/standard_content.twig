<section id="standard-content_{{ parent_loop.index|default(0) }}" class="pattern pattern--standard-content">
    <div class="container container--md">
        
        {% if layout.pattern_headline %}
        <h2 class="pattern__headline">{{ layout.pattern_headline }}</h2>
        {% endif %}
        <div class="rtecontent"> {{ layout.content }}</div>
		
    </div>
</section>
