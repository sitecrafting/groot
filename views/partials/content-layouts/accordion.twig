{#
  ACCORDION
  * less/elements/layouts/pattern-accordion.less
  * js/src/jquery.accordion.js
#}
<section id="accordion_{{ parent_loop.index|default(0) }}" class="pattern pattern--accordion">
    <div class="container container--md">

        {% if layout.pattern_headline %}
            <h2 class="pattern__headline">{{ layout.pattern_headline }}</h2>
        {% endif %}

        {% if layout.pattern_content %}
            <div class="rtecontent">{{ layout.pattern_content }}</div>
        {% endif %}

        <div class="accordion">
        {% for panel in layout.accordion_panels %}
            <details id="accordion-panel{{ parent_loop.index ~'_'~ loop.index }}">
                <summary><span>{{ panel.panel_headline }}</span> <span class="acc-toggle"></span></summary>
                <div class="rtecontent">{{ panel.panel_content }}</div>
            </details>
        {% endfor %}
        </div>

    </div>
</section>
