
<article class="card-article">
    <div class="card-article__image">
    {% if post.meta('post_card_image') %}
        {% include 'partials/blocks/image.twig' with { image : post.meta('post_card_image'), crop: 'article-card' } %}
    {% endif %}
    </div>
	<div class="card-article__content">
		<h2 class="h4 title"><a href="{{ post.link }}">{{ post.title }}</a></h2>
		<div class="date">{{ post.date }}</div>
		<div class="excerpt">{{ post.content | excerpt(20) }}</div>

		<span class="btn">Read More</span>
	</div>
</article>
